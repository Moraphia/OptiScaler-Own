<ui:FluentWindow x:Class="OptiScalerManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="OptiScaler Manager" Width="1280" Height="820" MinWidth="1060" MinHeight="710"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackground}"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable Text, Segoe UI" Loaded="OnLoaded">
    <ui:FluentWindow.Resources>
        <Storyboard x:Key="PageEnter">
            <DoubleAnimation Storyboard.TargetName="PageRoot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="PageRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="4" To="0" Duration="0:0:0.16" />
        </Storyboard>
    </ui:FluentWindow.Resources>
    <Grid x:Name="PageRoot" Opacity="0">
        <Grid.RenderTransform><TranslateTransform Y="4" /></Grid.RenderTransform>
        <Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#EEF1F5" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0" Padding="16,22">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="8,0,0,34"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource Accent}" HorizontalAlignment="Left">
                            <TextBlock Text="O" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="OptiScaler" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="MANAGER" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{DynamicResource Workspace}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="12,0,0,10" />
                    <Border Background="#DDE8F8" CornerRadius="8" Margin="0,0,0,4">
                        <Grid><Border Width="3" Background="{StaticResource Accent}" HorizontalAlignment="Left" CornerRadius="2" Margin="0,9"/>
                            <Button Style="{StaticResource NavButton}" Background="Transparent" Margin="4,0,0,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Home24" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="{DynamicResource NavMyGames}" VerticalAlignment="Center"/></StackPanel></Button>
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource NavButton}" Click="UpdateClick" Margin="4,2,0,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowSync24" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="{DynamicResource NavUpdates}" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="MediaClick" Margin="4,2,0,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Video24" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="窗口／视频" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="SettingsClick" Margin="4,2,0,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="{DynamicResource NavSettings}" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,0">
                    <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Margin="0,0,0,14"/>
                    <TextBlock Text="{DynamicResource Language}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="4,0,0,8" />
                    <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="zh-CN" SelectionChanged="LanguageChanged">
                        <ComboBoxItem Content="中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en-US"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="34,30,36,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="{DynamicResource PageMyGames}" FontSize="29" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource PageMyGamesSubtitle}" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource NavScanSteam}" Click="ScanSteamClick" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource AddGame}" Click="AddGameClick" />
                    <Border Width="1" Background="{StaticResource PanelBorder}" Margin="16,3,16,3" />
                    <Button Style="{StaticResource WindowCloseButton}" Content="×" Click="CloseClick" AutomationProperties.Name="关闭主窗口" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="286"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,18,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="18,18,18,14">
                            <TextBlock Text="{DynamicResource MyGames}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="GameCount" Text="0" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                        </Grid>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" Content="{DynamicResource AddGameFolder}" Click="AddGameClick" Margin="14,10,14,14" />
                        <ListBox x:Name="GamesList" BorderThickness="0" Background="Transparent" SelectionChanged="GameSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="7,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Padding="12,11" CornerRadius="7"><ContentPresenter /></Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#E6EFFC" /></Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#F0F4F9" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate></Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate><StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding InstallPath}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                </StackPanel></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="当前游戏" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                            <TextBlock x:Name="SelectedName" Text="{DynamicResource NoGameSelected}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SelectedPath" Text="{DynamicResource SelectGameHint}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,0,14" />
                            <TextBlock x:Name="PipelineAdviceText" Text="" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button x:Name="CommonConfigButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource BasicConfig}" Click="CommonConfigClick" IsEnabled="False" Margin="0,0,8,8" />
                                <Button x:Name="ExpertConfigButton" Style="{StaticResource GhostButton}" Content="{DynamicResource ExpertConfig}" Click="ExpertConfigClick" IsEnabled="False" Margin="0,0,8,8" />
                                <Button x:Name="PipelineButton" Style="{StaticResource GhostButton}" Content="渲染管线" Click="PipelineClick" IsEnabled="False" Margin="0,0,8,8" />
                                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource LaunchGame}" Click="LaunchClick" Margin="0,0,8,8" />
                                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Refresh}" Click="RefreshClick" Margin="0,0,0,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                    <TabItem Header="安装管理">
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource InstallStatus}" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock x:Name="InstallStatus" Text="等待选择" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Warning}" Margin="0,6,0,0" />
                                <TextBlock x:Name="InstallDetail" Text="选择游戏后显示检查结果" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource InstallRepair}" Click="InstallClick" Margin="0,0,8,0" />
                                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Uninstall}" Click="UninstallClick" Margin="0,0,8,0" />
                                <Button x:Name="AdoptLegacyButton" Style="{StaticResource GhostButton}" Content="{DynamicResource AdoptLegacy}" Click="AdoptLegacyClick" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    </TabItem>
                    <TabItem Header="运行诊断">
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource RuntimeDiagnostics}" FontSize="14" FontWeight="SemiBold" />
                            <Grid Grid.Row="1" Margin="0,16,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{DynamicResource ProxyDll}" Foreground="{StaticResource TextSecondary}" FontSize="11"/><TextBlock x:Name="ProxyText" Text="—" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource SyncStatus}" Foreground="{StaticResource TextSecondary}" FontSize="11"/><TextBlock x:Name="SyncText" Text="—" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Backup}" Foreground="{StaticResource TextSecondary}" FontSize="11"/><TextBlock x:Name="BackupText" Text="—" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="2">
                                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource ManagedFiles}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Version}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="{DynamicResource Integrity}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="RuntimeGrid"><ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Version}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                            <TextBlock Grid.Column="2" Text="{Binding IntegrityText}" FontSize="11" Foreground="{StaticResource Success}" />
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                    </Border>

                    </TabItem>
                    <TabItem Header="操作记录">
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource OperationTimeline}" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="HealthText" Text="未选择" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="12,1,0,0"/><TextBlock x:Name="RuntimeText" Text="未检测" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="8,1,0,0"/></StackPanel>
                            <ListBox x:Name="OperationTimeline" Grid.Row="1" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextSecondary}" FontFamily="Cascadia Mono, Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,7,0,0" />
                        </Grid>
                    </Border>
                    </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
