<Window x:Class="OptiScalerManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiScaler Manager" Width="1240" Height="780" MinWidth="1020" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackground}"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{StaticResource TextPrimary}" Loaded="OnLoaded">
    <Window.Resources>
        <Storyboard x:Key="PageEnter">
            <DoubleAnimation Storyboard.TargetName="PageRoot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24" />
            <DoubleAnimation Storyboard.TargetName="PageRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="4" To="0" Duration="0:0:0.16" />
        </Storyboard>
    </Window.Resources>
    <Grid x:Name="PageRoot" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><TranslateTransform Y="4" /></Grid.RenderTransform>
        <Grid.ColumnDefinitions><ColumnDefinition Width="224" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#181B20" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0" Padding="16,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Margin="10,0,0,32">
                        <TextBlock Text="OptiScaler" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="管理器" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Text="工作区" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="10,0,0,10" />
                    <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavMyGames}" />
                    <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavScanSteam}" Click="ScanSteamClick" />
                    <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavUpdates}" Click="UpdateClick" />
                    <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavSettings}" Margin="0,3,0,0" Click="SettingsClick" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,8"><TextBlock Text="{DynamicResource Language}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="LanguageBox" Width="104" SelectedValuePath="Tag" SelectedValue="zh-CN" SelectionChanged="LanguageChanged"><ComboBoxItem Content="中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en-US"/></ComboBox></StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="34,28,38,30">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource PageMyGames}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource PageMyGamesSubtitle}" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource CheckUpdates}" Click="UpdateClick" Margin="0,0,10,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource AddGame}" Click="AddGameClick" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,1" Padding="0,10" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Library}" FontSize="10" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock x:Name="GameCount" Text="0" FontSize="12" FontWeight="SemiBold" Margin="8,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Status}" FontSize="10" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock x:Name="HealthText" Text="未选择" FontSize="12" Foreground="{StaticResource Success}" Margin="8,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Channel}" FontSize="10" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Stable}" FontSize="12" Foreground="{StaticResource Accent}" Margin="8,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Runtime}" FontSize="10" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock x:Name="RuntimeText" Text="未选择" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,18,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="17,16,17,12"><TextBlock Text="{DynamicResource MyGames}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource SelectProject}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" /></StackPanel>
                        <ListBox x:Name="GamesList" BorderThickness="0" Background="Transparent" SelectionChanged="GameSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="8,2" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Padding="10" CornerRadius="5"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#303B46" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#292F36" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding InstallPath}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,3,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" Content="{DynamicResource AddGameFolder}" Margin="17,12,17,17" Click="AddGameClick" />
                    </DockPanel>
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
                        <Grid>
                            <StackPanel><TextBlock x:Name="SelectedName" Text="{DynamicResource NoGameSelected}" FontSize="23" FontWeight="SemiBold" /><TextBlock x:Name="SelectedPath" Text="{DynamicResource SelectGameHint}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,5,0,0" /></StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource GhostButton}" Content="{DynamicResource Refresh}" Click="RefreshClick" Margin="0,0,9,0" /><Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource LaunchGame}" Click="LaunchClick" /></StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="{DynamicResource InstallStatus}" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="InstallStatus" Text="等待选择" FontSize="20" Foreground="{StaticResource Warning}" Margin="0,19,0,4" /><TextBlock x:Name="InstallDetail" Text="选择游戏后开始检查" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Margin="0,23,0,0"><Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource InstallRepair}" Click="InstallClick" Margin="0,0,8,0" /><Button Style="{StaticResource GhostButton}" Content="{DynamicResource Uninstall}" Click="UninstallClick" Margin="0,0,8,0" /><Button x:Name="AdoptLegacyButton" Style="{StaticResource GhostButton}" Content="{DynamicResource AdoptLegacy}" Click="AdoptLegacyClick" Visibility="Collapsed" /></StackPanel></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="{DynamicResource RuntimeDiagnostics}" FontSize="15" FontWeight="SemiBold" /><StackPanel Margin="0,15,0,10"><TextBlock Text="{DynamicResource ProxyDll}" FontSize="11" Foreground="{StaticResource TextSecondary}" /><TextBlock x:Name="ProxyText" Text="—" Margin="0,3,0,9" /><TextBlock Text="RuntimeSync" FontSize="11" Foreground="{StaticResource TextSecondary}" /><TextBlock x:Name="SyncText" Text="—" Margin="0,3,0,9" /><TextBlock Text="{DynamicResource Backup}" FontSize="11" Foreground="{StaticResource TextSecondary}" /><TextBlock x:Name="BackupText" Text="—" Margin="0,3,0,7" /></StackPanel><Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="0,8,0,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource ManagedRuntime}" FontSize="11" Foreground="{StaticResource TextSecondary}"/><TextBlock Grid.Column="1" Text="{DynamicResource Version}" FontSize="10" Foreground="{StaticResource TextSecondary}"/><TextBlock Grid.Column="2" Text="{DynamicResource Integrity}" FontSize="10" Foreground="{StaticResource TextSecondary}"/></Grid><ItemsControl x:Name="RuntimeGrid"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Version}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{StaticResource TextSecondary}"/><TextBlock Grid.Column="2" Text="{Binding IntegrityText}" FontSize="10" Foreground="{StaticResource Success}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></Border>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="86"/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource OperationTimeline}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource RecentOperation}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="8,2,0,0"/></StackPanel>
                            <ListBox x:Name="OperationTimeline" Grid.Row="1" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextSecondary}" FontFamily="Cascadia Mono, Consolas" FontSize="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
