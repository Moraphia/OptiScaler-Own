<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>OptiScalerManager</AssemblyName>
    <RootNamespace>OptiScalerManager.App</RootNamespace>
    <Version>0.2.4</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.4.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PublishDir>$(MSBuildThisFileDirectory)..\publish\</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <ProjectReference Include="..\OptiScalerManager.Core\OptiScalerManager.Core.csproj" />
    <None Include="..\..\upstreams.json" Link="upstreams.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\upstreams.lock.json" Link="upstreams.lock.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="dependency-inventory.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="source-submodules.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="pipeline-dependencies.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Licenses\WPF-UI_LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Licenses\WPF-UI_ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
