<Window x:Class="OptiScalerManager.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="620" Height="530" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBackground}"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource NavSettings}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="界面偏好与安装默认值" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,6,0,0"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,28,0,0">
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="界面" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="语言" VerticalAlignment="Center"/><ComboBox x:Name="LanguageBox" Grid.Column="1" Height="32" SelectedValuePath="Tag"><ComboBoxItem Content="中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en-US"/></ComboBox></Grid>
                    <CheckBox x:Name="ReduceAnimationsBox" Content="减少动画" Margin="190,14,0,0"/><TextBlock Text="减少页面切换动画。" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="190,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="安装默认值" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="默认 Proxy DLL" VerticalAlignment="Center"/><ComboBox x:Name="ProxyBox" Grid.Column="1" Height="32"><ComboBoxItem Content="dxgi.dll"/><ComboBoxItem Content="winmm.dll"/><ComboBoxItem Content="version.dll"/><ComboBoxItem Content="d3d12.dll"/><ComboBoxItem Content="dbghelp.dll"/><ComboBoxItem Content="wininet.dll"/><ComboBoxItem Content="winhttp.dll"/></ComboBox><TextBlock Grid.Row="1" Text="图形 API 偏好" VerticalAlignment="Center" Margin="0,14,0,0"/><ComboBox x:Name="GraphicsApiBox" Grid.Row="1" Grid.Column="1" Height="32" Margin="0,14,0,0"><ComboBoxItem Content="Auto"/><ComboBoxItem Content="DirectX 11"/><ComboBoxItem Content="DirectX 12"/><ComboBoxItem Content="Vulkan"/></ComboBox></Grid>
                    <TextBlock Text="代理 DLL 只影响后续安装或修复，不会改动现有游戏。" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="190,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Button x:Name="OpenConfigButton" Style="{StaticResource GhostButton}" Content="打开当前游戏配置" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OpenConfigClick"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Style="{StaticResource GhostButton}" Content="取消" Width="86" Margin="0,0,10,0" Click="CancelClick"/><Button Style="{StaticResource PrimaryButton}" Content="保存设置" Width="100" Click="SaveClick"/></StackPanel>
    </Grid>
</Window>
