<Window x:Class="OptiScalerManager.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UpdateCenter}" Width="960" Height="700" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBackground}"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{DynamicResource UpdateCenter}" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="稳定版：管理器与游戏安装包分别下载、分别校验；不会用官方包覆盖独立分支。" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,24,0,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="稳定版频道" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock x:Name="ReleaseName" Text="尚未检查" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock x:Name="ReleaseMeta" Text="手动检查不会影响当前安装" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0" />
                    <TextBlock x:Name="ManagerVersionState" Text="管理器：读取中" FontSize="12" Margin="0,12,0,0" />
                    <TextBlock x:Name="PackageVersionState" Text="本机游戏包：读取中" FontSize="12" Margin="0,4,0,0" />
                    <TextBlock Text="游戏包状态只针对管理器已下载并校验的包；已安装到各游戏的文件需另行核对。" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,7,0,0" />
                </StackPanel>
                <Border x:Name="StatusBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#19352F" CornerRadius="12" Padding="10,5">
                    <TextBlock x:Name="StatusText" Text="READY" Foreground="{StaticResource Success}" FontSize="10" FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="{DynamicResource PackageCheck}" Padding="14,8">
                <Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="包检查" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="PackageState" Text="等待下载" Foreground="{StaticResource TextSecondary}" Margin="12,2,0,0" /></StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBox x:Name="Details" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" /></ScrollViewer></Border>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource DependencyMatrix}" Padding="14,8">
                <Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="本版游戏包随附的关键运行库版本（发布清单；不是当前游戏已安装版本）" FontSize="13" FontWeight="SemiBold" />
                    <DataGrid x:Name="RuntimeGrid" Grid.Row="1" Margin="0,8,0,10" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" Foreground="{StaticResource TextPrimary}" RowBackground="#1B1E23" AlternatingRowBackground="#20242A" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns><DataGridTextColumn Header="组件" Binding="{Binding Name}" Width="160"/><DataGridTextColumn Header="文件" Binding="{Binding Files}" Width="*"/><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="100"/><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="180"/><DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="150"/></DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="上游追踪：锁定引用用于维护和升级评估，不代表包内 DLL 版本，也不自动判定需要更新。" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <DataGrid x:Name="DependencyGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" Foreground="{StaticResource TextPrimary}" RowBackground="#1B1E23" AlternatingRowBackground="#20242A" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns><DataGridTextColumn Header="依赖" Binding="{Binding Id}" Width="145"/><DataGridTextColumn Header="仓库" Binding="{Binding Repository}" Width="*"/><DataGridTextColumn Header="策略" Binding="{Binding Policy}" Width="80"/><DataGridTextColumn Header="锁定引用" Binding="{Binding Version}" Width="115"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="许可证" Binding="{Binding License}" Width="130"/></DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="RepositoryBox" Width="190" Height="32" VerticalContentAlignment="Center" ToolTip="自己的 GitHub 仓库：owner/repo" Margin="0,0,8,0" />
                <Button Style="{StaticResource GhostButton}" Content="设置更新源" Click="SetRepositoryClick" Margin="0,0,8,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Close}" IsCancel="True" Width="86" Margin="0,0,10,0" Click="CloseClick" />
            <Button x:Name="CheckButton" Style="{StaticResource GhostButton}" Content="{DynamicResource CheckUpdates}" Width="110" Margin="0,0,10,0" Click="CheckClick" />
            <Button x:Name="DownloadManagerButton" Style="{StaticResource GhostButton}" Content="下载管理器" Width="110" IsEnabled="False" Margin="0,0,8,0" Click="DownloadManagerClick" />
            <Button x:Name="DownloadGameButton" Style="{StaticResource PrimaryButton}" Content="下载游戏包" Width="110" IsEnabled="False" Click="DownloadGameClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
