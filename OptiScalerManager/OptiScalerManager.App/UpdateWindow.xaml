<Window x:Class="OptiScalerManager.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UpdateCenter}" Width="760" Height="640" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBackground}"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{DynamicResource UpdateCenter}" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="从已发布的版本清单获取经过构建和校验的安装包。" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,24,0,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="稳定版频道" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock x:Name="ReleaseName" Text="尚未检查" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock x:Name="ReleaseMeta" Text="手动检查不会影响当前安装" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <Border x:Name="StatusBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#19352F" CornerRadius="12" Padding="10,5">
                    <TextBlock x:Name="StatusText" Text="READY" Foreground="{StaticResource Success}" FontSize="10" FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="{DynamicResource PackageCheck}" Padding="14,8">
                <Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="包检查" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="PackageState" Text="等待下载" Foreground="{StaticResource TextSecondary}" Margin="12,2,0,0" /></StackPanel>
                    <Border Grid.Row="1" Background="#10161F" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBox x:Name="Details" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled" FontFamily="Cascadia Mono, Consolas" FontSize="11" /></ScrollViewer></Border>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource DependencyMatrix}" Padding="14,8">
                <DataGrid x:Name="DependencyGrid" Margin="0,14,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Background="#10161F" BorderBrush="{StaticResource PanelBorder}" Foreground="{StaticResource TextPrimary}" RowBackground="#111827" AlternatingRowBackground="#0E1624" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns><DataGridTextColumn Header="依赖" Binding="{Binding Id}" Width="145"/><DataGridTextColumn Header="仓库" Binding="{Binding Repository}" Width="*"/><DataGridTextColumn Header="策略" Binding="{Binding Policy}" Width="80"/><DataGridTextColumn Header="锁定版本" Binding="{Binding Version}" Width="115"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="许可证" Binding="{Binding License}" Width="130"/></DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Close}" IsCancel="True" Width="86" Margin="0,0,10,0" Click="CloseClick" />
            <Button x:Name="CheckButton" Style="{StaticResource GhostButton}" Content="{DynamicResource CheckUpdates}" Width="110" Margin="0,0,10,0" Click="CheckClick" />
            <Button x:Name="DownloadButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource DownloadAndCheck}" Width="130" IsEnabled="False" Click="DownloadClick" />
        </StackPanel>
    </Grid>
</Window>
